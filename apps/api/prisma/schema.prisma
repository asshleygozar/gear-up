generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Accounts {
  accountId                                               Int            @id @default(autoincrement()) @map("account_id")
  accountName                                             String         @map("account_name") @db.VarChar(255)
  accountType                                             String         @map("account_type") @db.VarChar(255)
  totalBalance                                            Decimal        @map("total_balance") @db.Decimal(10, 2)
  totalIncome                                             Decimal        @map("total_income") @db.Decimal(10, 2)
  totalExpense                                            Decimal        @map("total_expense") @db.Decimal(10, 2)
  userId                                                  Int            @map("user_id")
  users                                                   Users          @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)
  transactions_transactions_account_id_receiverToaccounts Transactions[] @relation("transactions_account_id_receiverToaccounts")
  transactions                                            Transactions[]

  @@map("accounts")
}

model Transactions {
  transactionId                                       Int           @id @default(autoincrement()) @map("transaction_id")
  transactionCategory                                 String        @map("transactionCategory") @db.VarChar(255)
  transactionAmount                                   Decimal       @map("transaction_amount") @db.Decimal(10, 2)
  transactionDate                                     DateTime      @default(now()) @map("transaction_date") @db.Timestamp(6)
  transactionDescription                              String?       @map("transaction_description") @db.VarChar(255)
  accountId                                           Int           @map("account_id")
  userId                                              Int           @map("user_id")
  accountIdReceiver                                   Int?          @map("account_id_receiver")
  transactionType                                     transac_type? @map("transaction_type")
  accounts_transactions_account_id_receiverToaccounts Accounts?     @relation("transactions_account_id_receiverToaccounts", fields: [accountIdReceiver], references: [accountId], onDelete: Cascade, onUpdate: NoAction, map: "fk_account_receiver")
  accounts                                            Accounts      @relation(fields: [accountId], references: [accountId], onDelete: Cascade, onUpdate: NoAction)
  users                                               Users         @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@map("transactions")
}

model Users {
  email        String         @unique @db.VarChar(255)
  password     String         @db.VarChar(255)
  firstName    String?        @map("first_name") @db.VarChar(255)
  lastName     String?        @map("last_name") @db.VarChar(255)
  username     String         @unique @db.VarChar(255)
  userId       Int            @id @default(autoincrement()) @map("user_id")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime       @default(now()) @map("updated_at") @db.Timestamp(6)
  accounts     Accounts[]
  budgets      Budgets[]
  transactions Transactions[]

  @@map("users")
}

model Budgets {
  budgetId            Int                @id @default(autoincrement()) @map("budget_id")
  budgetCurrentAmount Decimal?           @map("budget_current_amount") @db.Decimal(10, 2)
  budgetStart         DateTime           @map("budget_start") @db.Timestamp(6)
  budgetEnd           DateTime           @map("budget_end") @db.Timestamp(6)
  budgetPeriod        budget_period_type @map("budget_period")
  budgetCategory      String             @map("budget_category") @db.VarChar(255)
  budgetDescription   String?            @map("budget_description") @db.VarChar(255)
  userId              Int                @map("user_id")
  budgetMaxAmount     Decimal            @map("budget_max_amount") @db.Decimal(10, 2)
  users               Users              @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction)

  @@map("budgets")
}

enum transac_type {
  income
  expense
  transfer
}

enum budget_period_type {
  weekly
  monthly
  one_time @map("one-time")
  daily
}
